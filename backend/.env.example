DATABASE_URL=sqlite:///./tax_filing.db
STORAGE_ROOT=../storage
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision:latest
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
ENABLE_VISION=false
# Optional Azure Document Intelligence fallback: runs alongside Tesseract on
# scanned pages; whichever result passes verification/has higher confidence
# is used. Leave ENABLE_AZURE_DI=false (or the endpoint/key blank) to disable.
ENABLE_AZURE_DI=false
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
VERIFICATION_THRESHOLD=0.97
MAX_REMEDIATION_ATTEMPTS=2
TAX_YEAR=2025-26
EFILE_BACKEND=json_self_file
FORM16_EXTRACTOR=label
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_DOCUMENTS=10
RETENTION_DAYS=7
# Empty API key is permitted only for a trusted local demo.
API_KEY=
LOG_LEVEL=INFO
# Optional authenticated encryption for checkpoint values; keep secret across restarts.
CHECKPOINT_ENCRYPTION_KEY=
